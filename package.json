{
  "name": "mcp-latchkey",
  "version": "0.1.0",
  "description": "Per-person, per-service sign-in for your self-hosted MCP servers, built for Claude.ai and any OIDC provider.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "latchkey": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/cli.js serve"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "hono": "^4.13.17",
    "jose": "^6.2.16",
    "openid-client": "^6.8.9",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vitest": "^5.1.0"
  },
  "author": "Ian Buffington",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robot-apocalypse/mcp-latchkey.git"
  },
  "homepage": "https://github.com/robot-apocalypse/mcp-latchkey#readme",
  "bugs": {
    "url": "https://github.com/robot-apocalypse/mcp-latchkey/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "oauth",
    "oidc",
    "gateway",
    "claude",
    "self-hosted",
    "homelab"
  ],
  "private": true
}
